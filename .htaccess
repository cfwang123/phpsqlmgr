# sqlmnger — Apache
# 修复静态 JS/CSS 中文乱码：强制 UTF-8 Content-Type
# （源码本身为 UTF-8 无 BOM；未声明 charset 时浏览器可能按系统编码误读）

# 默认字符集
AddDefaultCharset UTF-8

# MIME + charset（多数 Apache 有效）
AddType "application/javascript; charset=UTF-8" .js
AddType "text/css; charset=UTF-8" .css
AddType "application/json; charset=UTF-8" .json
AddType "image/svg+xml; charset=UTF-8" .svg
AddType "text/html; charset=UTF-8" .html .htm
AddType "text/plain; charset=UTF-8" .txt .md .map

# 后缀级 charset 兜底
AddCharset UTF-8 .js .css .json .svg .html .htm .txt .md .map .xml

# 明确覆盖响应头（需 mod_headers；比仅 AddType 更稳）
<IfModule mod_headers.c>
	<FilesMatch "\.js$">
		Header set Content-Type "application/javascript; charset=UTF-8"
	</FilesMatch>
	<FilesMatch "\.css$">
		Header set Content-Type "text/css; charset=UTF-8"
	</FilesMatch>
	<FilesMatch "\.json$">
		Header set Content-Type "application/json; charset=UTF-8"
	</FilesMatch>
	<FilesMatch "\.svg$">
		Header set Content-Type "image/svg+xml; charset=UTF-8"
	</FilesMatch>
</IfModule>

# PHP 默认输出编码（若允许 php_value；共享主机可能禁用）
<IfModule mod_php.c>
	php_value default_charset "UTF-8"
</IfModule>
<IfModule mod_php7.c>
	php_value default_charset "UTF-8"
</IfModule>
<IfModule mod_php8.c>
	php_value default_charset "UTF-8"
</IfModule>

# 可选：禁止列目录
Options -Indexes

# 可选：保护配置与日志（按需）
<IfModule mod_authz_core.c>
	<FilesMatch "(^\.htaccess$|^\.env$|config\.php$)">
		Require all denied
	</FilesMatch>
</IfModule>
# Apache 2.2
<IfModule !mod_authz_core.c>
	<FilesMatch "(^\.htaccess$|^\.env$|config\.php$)">
		Order allow,deny
		Deny from all
	</FilesMatch>
</IfModule>

# storage 下日志/库文件不建议直接 Web 访问（若 DocumentRoot 含 storage）
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^storage/ - [F,L]
	RewriteRule ^tmp/ - [F,L]
	RewriteRule ^config/ - [F,L]
</IfModule>
