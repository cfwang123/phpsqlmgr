.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# ── Backups & one-off ────────────────────────────────────
*.bak
*.old
*.orig
*.tmp
*.temp
*~
*.rej
*.swp

# ── Test / measure artifacts under tmp ───────────────────
tmp/*.png
tmp/*.jpg
tmp/*.jpeg
tmp/*.webp
tmp/*.json
tmp/*.html
tmp/*.mjs
tmp/*.py
tmp/*.ps1
tmp/*.7z
tmp/*.zip
